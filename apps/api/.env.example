PORT=3001
WEB_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://teamvault:change-me@localhost:5432/teamvault
# Generate a local development OAuth client in Google Cloud Console before setting these.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback
# Optional: required only when running the outbox relay worker. Create the topic separately.
# KAFKA_BROKERS=localhost:9092
# KAFKA_TOPIC=teamvault.domain-events
# For authenticated brokers, configure KAFKA_SSL=true and the SASL mechanism/username/password.
# Optional: required only for private file operations. Use an S3 bucket with Block Public Access enabled.
# AWS_REGION=us-east-1
# S3_BUCKET=teamvault-private-files
# FILE_MAX_BYTES=10485760
# FILE_MAX_CONCURRENT_UPLOADS=4
